# Copie para `.streamlit/secrets.toml` (ignorado pelo git) ou exporte como
# variáveis de ambiente. São as MESMAS credenciais do dashboard camda-estoque —
# este app abre o mesmo banco, só que somente para leitura.

TURSO_DATABASE_URL = "libsql://SEU-BANCO.turso.io"
TURSO_AUTH_TOKEN   = "SEU-TOKEN"

# Opcional: sem ela o app abre direto, sem tela de login.
CAMDA_ACCESS_PASSWORD = ""
